# Copy this file to .env.worker and paste the External Database URL from Render.
# Never commit .env.worker or send its contents in chat.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
EVENT_TIMEZONE=Asia/Ho_Chi_Minh
MATCHES_ENABLED=true
# Each computer uses a different ID so the admin can see which one ran a match.
WORKER_ID=may-1
# Admin creates matches manually; workers share one queue. Set true only if daily automatic pairing is desired.
AUTO_PAIR_ENABLED=false
AUTO_MATCH_START=00:00
MATCH_MAX_MOVES=200
MATCH_MOVE_TIMEOUT_SECONDS=1.5
SANDBOX_IMAGE=oantuti-sandbox:dev
APP_DATA=/app/data
