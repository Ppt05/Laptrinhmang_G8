# Copy this file to .env.worker and paste the External Database URL from Render.
# Never commit .env.worker or send its contents in chat.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
EVENT_TIMEZONE=Asia/Ho_Chi_Minh
MATCHES_ENABLED=true
# Each computer must use a different ID; choose it in the admin match form.
WORKER_ID=may-1
# Manual match assignment is the default. Set true only on one worker to pair all teams automatically.
AUTO_PAIR_ENABLED=false
AUTO_MATCH_START=00:00
MATCH_MAX_MOVES=200
MATCH_MOVE_TIMEOUT_SECONDS=1.5
SANDBOX_IMAGE=oantuti-sandbox:dev
APP_DATA=/app/data
