# Copy this file to .env.worker and paste the External Database URL from Render.
# Never commit .env.worker or send its contents in chat.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
EVENT_TIMEZONE=Asia/Ho_Chi_Minh
MATCHES_ENABLED=true
# Each computer uses a different ID so the admin can see which one ran a match.
WORKER_ID=may-1
# Daily pairing is disabled. Organizer starts Tournament batches.
AUTO_PAIR_ENABLED=false
MATCH_MAX_MOVES=200
MATCH_MOVE_TIMEOUT_SECONDS=1.5
MATCH_FIRST_MOVE_TIMEOUT_SECONDS=15
# Replace after building: docker image inspect oantuti-sandbox:dev --format '{{.Id}}'
# API and every worker must publish/use the same immutable image ID or registry digest.
SANDBOX_IMAGE=oantuti-sandbox:dev
SANDBOX_PYTHON_VERSION=3.11
SANDBOX_CPP_VERSION=g++-12
APP_DATA=/app/data
