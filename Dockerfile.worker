FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends docker.io docker-cli && rm -rf /var/lib/apt/lists/*
WORKDIR /srv
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app
RUN mkdir -p /app/data/artifacts && useradd --uid 10001 --create-home appuser && chown -R appuser:appuser /app/data
# Access to the Docker socket is root-equivalent. Keep this trusted worker isolated from public traffic.
USER root
CMD ["python", "-m", "app.worker"]
