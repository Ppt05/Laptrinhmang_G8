DATABASE_URL=postgresql+psycopg://oantuti:compose-overrides-this@db:5432/oantuti
POSTGRES_PASSWORD=replace-with-a-strong-random-password
ADMIN_API_KEY=replace-with-a-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
# Replace after building: docker image inspect oantuti-sandbox:dev --format '{{.Id}}'
# API and every worker must publish/use the same immutable image ID or registry digest.
SANDBOX_IMAGE=oantuti-sandbox:dev
SANDBOX_PYTHON_VERSION=3.11
SANDBOX_CPP_VERSION=g++-12
APP_DATA=/app/data
MATCH_MOVE_TIMEOUT_SECONDS=1.5
MATCH_FIRST_MOVE_TIMEOUT_SECONDS=15
MATCH_MAX_MOVES=200
MATCHES_ENABLED=false
WORKER_ID=may-1
AUTO_PAIR_ENABLED=false
REGISTRATION_OPEN=true
MAX_SOURCE_BYTES=100000
EVENT_TIMEZONE=Asia/Ho_Chi_Minh
DOMAIN=api.example.com
