DATABASE_URL=postgresql+psycopg://oantuti:compose-overrides-this@db:5432/oantuti
POSTGRES_PASSWORD=replace-with-a-strong-random-password
ADMIN_API_KEY=replace-with-a-long-random-value
REGISTRATION_CODE=replace-before-opening-registration
SANDBOX_IMAGE=oantuti-sandbox:dev
APP_DATA=/app/data
MATCH_MOVE_TIMEOUT_SECONDS=1.5
MATCH_MAX_MOVES=200
MATCHES_ENABLED=false
REGISTRATION_OPEN=true
MAX_SOURCE_BYTES=100000
CHALLENGE_START=20:00
CHALLENGE_END=22:00
AUTO_MATCH_START=19:00
EVENT_TIMEZONE=Asia/Ho_Chi_Minh
DOMAIN=api.example.com
